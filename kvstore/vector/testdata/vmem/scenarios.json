      ]
    },
    {
      "name": "ttl_plus_supersedes",
      "comment": "комбинация фильтров: supersession действует до истечения, erasure добивает историю после",
      "ops": [
        {"op": "remember", "id": "f1", "scope": "user:dana", "text": "Купон SPRING действует", "at": 100, "ttl": 300},
        {"op": "remember", "id": "f2", "scope": "user:dana", "text": "Купон SPRING отменён", "at": 200, "supersedes": "f1"}
      ],
      "queries": [
        {"id": "q_now_alive", "comment": "f1 ещё не истёк (expires 400), но уже устарел", "scope": "user:dana", "query": "купон", "now": 250, "expect": ["f2"]},
        {"id": "q_asof_alive", "comment": "история доступна, пока факт не стёрт", "scope": "user:dana", "query": "купон", "as_of": 150, "now": 250, "expect": ["f1"]},
        {"id": "q_asof_expired", "comment": "после expires_at история f1 стёрта; f2 в t=150 ещё не существовал", "scope": "user:dana", "query": "купон", "as_of": 150, "now": 500, "expect": []}
      ]
    },
    {
      "name": "scoring_importance",
      "comment": "шаг 5 (порядок, не множество): важное сопротивляется затуханию — аллергия важнее упоминания в статье",
      "ops": [
        {"op": "remember", "id": "f1", "scope": "user:dana", "text": "Аллергия на пенициллин", "type": "fact", "importance": 0.9, "at": 100},
        {"op": "remember", "id": "f2", "scope": "user:dana", "text": "Упоминал пенициллин в статье", "type": "event", "importance": 0.1, "at": 100}
      ],
      "queries": [
        {"id": "q1", "scoring": true, "expect_first": "f1", "scope": "user:dana", "query": "пенициллин", "now": 1000, "expect": ["f1", "f2"]}
      ]
    },
    {
      "name": "scoring_freshness",
      "comment": "шаг 5 (порядок, не множество): при равной релевантности и важности свежий факт выше старого",
      "ops": [
        {"op": "remember", "id": "f_old", "scope": "user:dana", "text": "Проект использует Postgres", "at": 100},
        {"op": "remember", "id": "f_new", "scope": "user:dana", "text": "Проект использует Postgres", "at": 5000}
      ],
      "queries": [
        {"id": "q1", "scoring": true, "expect_first": "f_new", "scope": "user:dana", "query": "Postgres", "now": 6000, "expect": ["f_old", "f_new"]}
      ]
    }
  ]
}
